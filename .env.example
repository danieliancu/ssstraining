DJANGO_SETTINGS_MODULE=sst.settings.dev
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000

DATABASE_URL=mysql://root:@127.0.0.1:3306/sst_django
# Local XAMPP ships MariaDB 10.4; this backend relaxes Django's 10.5 check. Remove in production.
DATABASE_ENGINE=sst.db_mysql_legacy
# Only needed for the wp_import_* commands
WP_DATABASE_URL=mysql://root:@127.0.0.1:3306/sst
WP_ROOT=C:/xampp/htdocs/sst
WP_PHP_BIN=C:/xampp/php/php.exe

# Email (console locally; apps.emails.backends.BrevoEmailBackend in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
BREVO_API_KEY=
RECAPTCHA_SECRET_KEY=
DEFAULT_FROM_EMAIL=Site Safety Training <noreply@sstcourses.co.uk>
ORDER_ADMIN_EMAILS=

# MMC - rotate the webhook secret before go-live (the old default was hard-coded in the WP plugin)
MMC_API_BASE=https://targetzero.managemycourses.co.uk/api/v1
MMC_CLIENT_ID=
MMC_CLIENT_SECRET=
MMC_WEBHOOK_SECRET=

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

GA4_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=F8GtZx6rzWAjI4FL-9zstMgZSmvkinQJmV8tCbv0tZg
